<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Device-capability suite: backgrounding, rotation, native dialogs, deep links,
  connectivity and gestures. Separated from regression because these mutate device
  state (orientation, radios) and need an emulator that permits it.
-->
<suite name="Mobile native" verbose="1" parallel="none">

    <test name="Mobile native - Android">
        <groups>
            <run>
                <include name="mobile-native"/>
            </run>
        </groups>
        <classes>
            <class name="com.adarsh.tests.AppLifecycleTest"/>
            <class name="com.adarsh.tests.DeviceInteractionTest"/>
            <class name="com.adarsh.tests.GestureTest"/>
            <class name="com.adarsh.tests.CatalogTest"/>
        </classes>
    </test>

</suite>
